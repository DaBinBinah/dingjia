{
  "version": "2.0",
  "envId": "your-cloudbase-env-id",
  "$schema": "https://static.cloudbase.net/cli/cloudbaserc.schema.json",
  "hosting": {
    "localPath": "./web",
    "cloudPath": "ths"
  },
  "functionRoot": "cloudfunctions",
  "functions": [
    {
      "name": "ths-get-portfolio",
      "timeout": 15,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "envVariables": {
        "THS_API_KEY": "your-ths-api-key"
      }
    },
    {
      "name": "ths-create-holding",
      "timeout": 10,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "envVariables": {
        "THS_API_KEY": "your-ths-api-key"
      }
    },
    {
      "name": "ths-update-holding",
      "timeout": 10,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true
    },
    {
      "name": "ths-delete-holding",
      "timeout": 10,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true
    },
    {
      "name": "ths-update-account",
      "timeout": 10,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true
    },
    {
      "name": "ths-import-holdings",
      "timeout": 20,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "envVariables": {
        "THS_API_KEY": "your-ths-api-key"
      }
    },
    {
      "name": "ths-get-dividends",
      "timeout": 15,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "envVariables": {
        "THS_API_KEY": "your-ths-api-key"
      }
    },
    {
      "name": "ths-get-watches",
      "timeout": 15,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "envVariables": {
        "THS_API_KEY": "your-ths-api-key",
        "THS_WECHAT_MP_APPID": "your-wechat-mp-appid",
        "THS_WECHAT_MP_SECRET": "your-wechat-mp-secret",
        "THS_WECHAT_MP_TEMPLATE_ID": "your-template-id",
        "THS_WECHAT_MP_OPENID": "your-wechat-openid"
      }
    },
    {
      "name": "ths-get-alerts",
      "timeout": 10,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true
    },
    {
      "name": "ths-get-history",
      "timeout": 15,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "envVariables": {
        "THS_API_KEY": "your-ths-api-key"
      }
    },
    {
      "name": "ths-check-market",
      "timeout": 30,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "envVariables": {
        "THS_API_KEY": "your-ths-api-key",
        "THS_WECHAT_MP_APPID": "your-wechat-mp-appid",
        "THS_WECHAT_MP_SECRET": "your-wechat-mp-secret",
        "THS_WECHAT_MP_TEMPLATE_ID": "your-template-id",
        "THS_WECHAT_MP_OPENID": "your-wechat-openid"
      },
      "triggers": [
        {
          "name": "ths-timer-10s",
          "type": "timer",
          "config": "*/10 * * * * * *"
        }
      ]
    },
    {
      "name": "ths-create-watch",
      "timeout": 10,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "envVariables": {
