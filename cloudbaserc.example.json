      "handler": "index.main",
      "installDependency": true
    },
    {
      "name": "ths-get-notes",
      "timeout": 10,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true
    },
    {
      "name": "ths-create-note",
      "timeout": 10,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true
    },
    {
      "name": "ths-delete-note",
      "timeout": 10,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true
    },
    {
      "name": "ths-get-market-overview",
      "timeout": 15,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "envVariables": {
        "THS_API_KEY": "your-ths-api-key"
      }
    },
    {
      "name": "ths-get-ai-summary",
      "timeout": 10,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true
    },
    {
      "name": "ths-get-price-touches",
      "timeout": 15,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "envVariables": {
        "THS_API_KEY": "your-ths-api-key"
      }
    },
    {
      "name": "ths-ack-price-touch",
