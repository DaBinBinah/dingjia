      }
    },
    {
      "name": "ths-update-watch",
      "timeout": 10,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "envVariables": {
        "THS_API_KEY": "your-ths-api-key"
      }
    },
    {
      "name": "ths-delete-watch",
      "timeout": 10,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true
    },
    {
      "name": "ths-import-watches",
      "timeout": 20,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "envVariables": {
