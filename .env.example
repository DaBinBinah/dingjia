# 腾讯云开发 CloudBase 环境变量配置示例
# 复制本文件为 .env 并填入您的真实凭证

# 腾讯云环境 ID
TCB_ENV_ID=your-cloudbase-env-id

# 同花顺金融数据 API 密钥（获取自同花顺开放平台）
THS_API_KEY=your-ths-api-key

# 微信公众平台模板消息配置（微信测试号/服务号）
THS_WECHAT_MP_APPID=your-wechat-mp-appid
THS_WECHAT_MP_SECRET=your-wechat-mp-secret
THS_WECHAT_MP_TEMPLATE_ID=your-template-id
THS_WECHAT_MP_OPENID=your-wechat-openid

# 可选通知渠道配置
THS_SERVERCHAN_KEY=your-serverchan-sendkey
THS_PUSHPLUS_TOKEN=your-pushplus-token
THS_WECOM_WEBHOOK=your-wecom-robot-webhook
